# ============================================================
# ADEARA DEVELOPMENT — Environment Variables
# ============================================================
# Copy to .env (local) or set in Vercel dashboard → Settings → Environment Variables.
#
# See DEPLOYMENT.md for the complete Vercel + GitHub setup walkthrough.
# ============================================================

# === Database ===
#
# --- Local development (SQLite) ---
DATABASE_URL=file:/home/z/my-project/db/custom.db
DATABASE_PROVIDER=sqlite
#
# --- Production (Vercel Postgres or external PostgreSQL) ---
# Get this from Vercel → Storage tab → "Create Database" → Postgres, then copy the connection string.
# DATABASE_URL=postgres://default:xxxxxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require
# DATABASE_PROVIDER=postgresql
#
# Alternative: Neon (https://neon.tech) — fast serverless Postgres with a generous free tier
# DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_PROVIDER=postgresql
#
# Alternative: Supabase (https://supabase.com) — managed Postgres + Storage
# DATABASE_URL=postgresql://postgres.xxxxx:password@db.xxxxx.supabase.co:5432/postgres
# DATABASE_PROVIDER=postgresql

# === NextAuth ===
# Generate a long random string (min 32 chars):
#   openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-long-random-string-in-production
#
# The public URL of your deployed site.
NEXTAUTH_URL=http://localhost:3000
# On Vercel: NEXTAUTH_URL=https://your-project.vercel.app (or your custom domain)

# === Seed Admin (only used by `bun run scripts/seed.ts`) ===
# These credentials create the initial admin user. Change after first login.
SEED_ADMIN_EMAIL=admin@adeara.dev
SEED_ADMIN_PASSWORD=ADEARA-admin-2025
SEED_ADMIN_NAME=ADEARA Administrator

# === SMTP for Email Notifications ===
# Required in production for real email delivery. Without these, emails are logged to console + EmailLog table.
# Submissions always save to the database first, so a missing SMTP never loses data.
#
# Example for Gmail (use an App Password, not your regular password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM_EMAIL=noreply@adeara.dev
# SMTP_FROM_NAME=ADEARA DEVELOPMENT
#
# Example for Resend (https://resend.com — recommended, simple):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx
# SMTP_FROM_EMAIL=noreply@adeara.dev
# SMTP_FROM_NAME=ADEARA DEVELOPMENT

# === Vercel Blob storage (required on Vercel for media uploads) ===
# Create a Blob store in Vercel → Storage → Create → Blob, then connect it to your project.
# This token is auto-populated by Vercel when you connect the store to your project.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxx
#
# In development without this token, media uploads fall back to /public/uploads/ on the local filesystem.
